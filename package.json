{
  "name": "grateful.tw",
  "version": "0.0.0",
  "private": true,
  "description": "grateful.tw monorepo — Web + Mobile + Firebase Functions",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start:web": "ng serve web",
    "start:mobile": "ng serve mobile",
    "build:web": "ng build web",
    "build:mobile": "ng build mobile",
    "cap:sync": "cap sync",
    "check": "npm run build:web && npm run build:mobile && npx cap sync",
    "emulators": "firebase emulators:start --only auth,firestore --project grateful-tw",
    "seed:emulator": "node scripts/seed-emulator-user.mjs",
    "test:web": "ng test web",
    "test:mobile": "ng test mobile",
    "test:unit": "vitest run tests/unit shared/contracts",
    "test:integration": "firebase emulators:exec --only firestore --project grateful-tw -- vitest run tests/integration"
  },
  "dependencies": {
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30",
    "@angular/platform-browser": "20.3.30",
    "@angular/router": "20.3.30",
    "@capacitor/core": "8.5.1",
    "@ionic/angular": "8.8.19",
    "firebase": "12.18.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.36",
    "@angular/cli": "20.3.36",
    "@angular/compiler-cli": "20.3.30",
    "@capacitor/cli": "8.5.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase-tools": "15.30.0"
  }
}
